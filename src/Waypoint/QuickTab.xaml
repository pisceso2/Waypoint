<UserControl x:Class="Waypoint.QuickTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Waypoint">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,20,16" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Shell.Secondary}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="{l:Loc 'Chat lines sent as if typed into the game chat. A release install copies them instead: paste with Ctrl+V.'}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="{l:Loc 'Player'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="Player" Width="220" />
            </StackPanel>
            <StackPanel x:Name="GroupList" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="{l:Loc 'Line'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="CustomLine" Width="360" />
                <Button x:Name="SendCustomButton" Content="{l:Loc 'Send'}" Click="SendCustomClicked" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="State" Style="{StaticResource Shell.Secondary}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
